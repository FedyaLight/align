# Generated by script/package-arch.sh from the exact staged Linux release.
pkgname=align
pkgver=@VERSION@
pkgrel=1
pkgdesc='Sync your recordings. Keep your edit. Audio and video synchronization'
arch=('x86_64')
url='https://github.com/FedyaLight/align'
license=('GPL-3.0-only')
depends=('glibc>=2.39' 'gcc-libs' 'alsa-lib' 'fontconfig' 'freetype2'
         'libx11' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland'
         'vulkan-icd-loader' 'systemd-libs' 'zlib' 'hicolor-icon-theme')
optdepends=('vulkan-intel: Vulkan driver for Intel graphics'
            'vulkan-radeon: Vulkan driver for AMD graphics'
            'nvidia-utils: Vulkan driver for NVIDIA graphics'
            'xdg-desktop-portal: desktop file dialogs and integration')
# The input is already stripped. Rewriting PyInstaller binaries damages AAF.
options=('!strip' '!debug')
source=('align-payload.tar.gz')
sha256sums=('@PAYLOAD_SHA256@')

package() {
    install -d "$pkgdir/opt/align" "$pkgdir/usr/bin"
    cp -a "$srcdir/payload/." "$pkgdir/opt/align/"
    for executable in align align-cli align-mcp; do
        ln -s "/opt/align/$executable" "$pkgdir/usr/bin/$executable"
    done
    install -Dm644 "$srcdir/integration/com.align.app.desktop" \
        "$pkgdir/usr/share/applications/com.align.app.desktop"
    install -Dm644 "$srcdir/integration/com.align.app.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/com.align.app.metainfo.xml"
    install -Dm644 "$srcdir/integration/AppIcon.png" \
        "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/com.align.app.png"
    install -Dm644 "$srcdir/payload/LICENSE" "$pkgdir/usr/share/licenses/align/LICENSE"
}
